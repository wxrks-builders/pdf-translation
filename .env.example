# --- core ---
DATABASE_URL=postgres://localhost:5432/doctranslate
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- wxrks service account ---
WXRKS_API_URL=https://app.wxrks.com/api/v3
WXRKS_ACCESS_KEY=
WXRKS_SECRET=
# Org units are provisioned manually in the wxrks dashboard (no create API);
# free falls back to paid when unset.
WXRKS_PAID_ORG_UNIT_UUID=
WXRKS_FREE_ORG_UNIT_UUID=

# --- app secrets ---
COOKIE_SECRET=change-me-long-random

# --- email (magic-link login); unset in dev = link is logged instead ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=

# --- tuning ---
FREE_TIER_MAX_WORDS=1000
POLL_INTERVAL_MS=60000
RETENTION_DAYS=30
MAX_UPLOAD_MB=25
