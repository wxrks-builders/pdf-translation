# --- core ---
# Storage is SQLite; default path is ./data/doctranslate.db locally and
# /var/data/doctranslate.db in production (persistent volume). Override:
# SQLITE_PATH=
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- wxrks service account ---
WXRKS_API_URL=https://app.wxrks.com/api/v3
WXRKS_ACCESS_KEY=
WXRKS_SECRET=
# Org units are set up in the wxrks dashboard, with automatic translation on
# (README, "Operational prerequisite"); free falls back to paid when unset.
WXRKS_PAID_ORG_UNIT_UUID=
WXRKS_FREE_ORG_UNIT_UUID=

# --- app secrets ---
COOKIE_SECRET=change-me-long-random

# --- email (magic-link login, free-tier files email); unset in dev = login link is logged, no files email ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=
# EMAIL_REPLY_TO=help@wxrks.com
# Free-tier email step: optional JSON webhook per lead (n8n / CRM), and send caps
# LEAD_WEBHOOK_URL=
# FILES_EMAIL_DAILY_CAP=300
# FILES_EMAIL_PER_ADDRESS_DAILY=3

# --- word packs through Stripe Checkout; unset = a pack opens an email instead (DEPLOY.md) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- CRM events (accounts, free-tier emails, translations, purchases); unset = kept in crm_outbox until set ---
# CRM_EVENTS_URL=https://crm.wxrks.app/s/translate/events
# CRM_EVENTS_SECRET=

# --- Confidence Score (Smells, after delivery), reviewer suggestions, OCR models ---
# CONFIDENCE_SCORE=off
# MARKETPLACE_URL=https://marketplace.wxrks.com
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# --- tuning ---
FREE_TIER_MAX_WORDS=1000
POLL_INTERVAL_MS=60000
RETENTION_DAYS=30
MAX_UPLOAD_MB=25
